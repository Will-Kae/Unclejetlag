{
  "name": "unclejetlag",
  "version": "1.0.0",
  "private": true,
  "description": "Uncle Jetlag — travel media & intelligence platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "prebuild": "node scripts/copy-fonts.mjs && node scripts/fetch-photos.mjs",
    "predev": "node scripts/copy-fonts.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "harness:baseline": "UPDATE_BASELINE=1 vitest run tests/harness && UPDATE_BASELINE=1 playwright test e2e/baseline.spec.ts e2e/routes.spec.ts -g \"matches the reviewed baseline|write tests\""
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "ibantools": "4.5.4",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "1.56.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "3.2.7"
  }
}
