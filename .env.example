# Public site URL (no trailing slash). Used for canonicals, sitemap, OG, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://unclejetlag.com

# --- Google AdSense (leave empty until approved) ---
# e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
# Slot IDs from your AdSense dashboard (optional; falls back to auto format)
NEXT_PUBLIC_ADSENSE_SLOT_AFTER_INTRO=
NEXT_PUBLIC_ADSENSE_SLOT_MID_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_END_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# Show labelled ad placeholders for layout review (never in production)
NEXT_PUBLIC_SHOW_AD_PLACEHOLDERS=false

# --- Analytics (optional, loaded only after analytics consent) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google Search Console verification token (content of the meta tag) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Newsletter provider: none | webhook ---
NEWSLETTER_PROVIDER=brevo
# For "webhook": any endpoint that accepts JSON { email, source, consentedAt }
# (Zapier / Make / n8n / your ESP's form endpoint)
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_SECRET=
# For "brevo": API key (Brevo > SMTP & API > API keys), the list ID, and optionally a
# double opt-in template ID (recommended; sends a confirmation email first).
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
BREVO_DOI_REDIRECT_URL=https://unclejetlag.com/newsletter/confirmed
